---
// AI News Insights — home page (issue #7: FIT brand applied).
//
// Brand source of record: fit-solutions/brand@d2fef9e (pinned in
// .agent/prp/evidence/2026-06-07-issue7-brand-snapshot/). Tokens + page styling live in
// src/styles/starwind.css (FIT-mapped Starwind tokens) and src/styles/brand.css.
//
// Behavior preserved: app.js still renders #stats, #newsGrid, and populates the native
// #weekSelect at runtime by fetching ./news-data.json and ./archive/manifest.json. Those
// hooks are kept exactly; app.js is loaded with `is:inline` (unchanged, unbundled).
import "../styles/starwind.css";
import { Button } from "../components/starwind/button";
---
<!doctype html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Weekly AI News Insights - July 2026</title>
  <meta name="description" content="Weekly AI news insights through July 18, 2026 — curated for business audiences." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&family=Open+Sans:wght@400;600&family=Poppins:wght@500;600&display=swap" rel="stylesheet" />
  <link rel="icon" href="./icon.png" type="image/png" />
  <link rel="apple-touch-icon" href="./icon.png" />
</head>
<body>
  <main class="container">
    <nav class="masthead" aria-label="Main menu">
      <a href="#top" class="brand">
        <span class="brand-dot" aria-hidden="true"></span>
        <span>FIT Automate</span>
        <span class="brand-section">/ Insights</span>
      </a>
      <div class="week-control">
        <label class="week-picker" for="weekSelect">Week</label>
        <select id="weekSelect" class="week-select" aria-label="Select week">
          <option value="current">Current</option>
        </select>
      </div>
    </nav>

    <header class="hero" id="top">
      <p class="kicker">Week 29 · Updated July 18, 2026</p>
      <h1 class="site-title">Weekly AI News Insights</h1>
      <p class="subtitle">Curated signals on model launches, infrastructure spend, and market moves.</p>
      <div class="stats" id="stats" hidden></div>
    </header>

    <section class="section" id="stories">
      <div class="section-head">
        <h2>Top Stories</h2>
        <p>Verified from official posts and major wire/business outlets.</p>
      </div>
      <div class="news-grid" id="newsGrid"></div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <p class="footer-copy">&copy; 2026 Forward IT Thinking Inc. All rights reserved.</p>

      <div class="footer-cta" aria-label="Primary links">
        <Button href="https://fitautomate.com" variant="primary" size="sm">Visit FIT Automate</Button>
        <Button href="https://fitautomate.com/contact" variant="outline" size="sm">Start a Project</Button>
      </div>

      <nav class="footer-social" aria-label="Social links">
        <a class="social-link" href="https://www.linkedin.com/company/forward-it-thinking" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.94 8.5V19H3.5V8.5h3.44zM5.22 7.07A1.99 1.99 0 1 1 5.2 3.1a1.99 1.99 0 0 1 .02 3.98zM20.5 12.99V19h-3.43v-5.5c0-1.31-.47-2.2-1.64-2.2-.9 0-1.43.61-1.66 1.2-.09.2-.11.49-.11.78V19H10.2s.05-9.42 0-10.5h3.46v1.49l-.02.03h.02v-.03c.46-.7 1.28-1.7 3.11-1.7 2.27 0 3.73 1.49 3.73 4.7z"/></svg>
        </a>
        <a class="social-link" href="https://x.com/fitautomate" aria-label="X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.92 3H22l-6.73 7.69L23 21h-6.05l-4.74-6.2L6.78 21H3.7l7.2-8.23L3 3h6.2l4.28 5.66L18.92 3zm-1.06 16.18h1.68L8.27 4.74H6.47l11.39 14.44z"/></svg>
        </a>
        <a class="social-link" href="https://github.com/FITAutomate" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.1.68-.22.68-.48v-1.9c-2.78.61-3.37-1.18-3.37-1.18-.46-1.14-1.1-1.44-1.1-1.44-.9-.62.07-.6.07-.6 1 .08 1.53 1.03 1.53 1.03.88 1.5 2.31 1.07 2.88.82.09-.65.35-1.07.63-1.31-2.22-.25-4.55-1.12-4.55-4.98 0-1.1.39-2 1.03-2.7-.1-.25-.45-1.29.1-2.68 0 0 .84-.27 2.75 1.03a9.7 9.7 0 0 1 5 0c1.91-1.3 2.75-1.03 2.75-1.03.55 1.39.2 2.43.1 2.68.64.7 1.03 1.6 1.03 2.7 0 3.87-2.33 4.72-4.56 4.97.36.32.68.93.68 1.87v2.77c0 .26.18.58.69.48A10 10 0 0 0 12 2z"/></svg>
        </a>
        <a class="social-link" href="mailto:ai@forwarditthinking.com" aria-label="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm0 2v.2l9 6.3 9-6.3V7l-9 6.3L3 7z"/></svg>
        </a>
      </nav>
    </div>

    <p class="footer-meta">Data date: 2026-07-18</p>
  </footer>

  <script is:inline src="./app.js?v=20260718a"></script>
</body>
</html>

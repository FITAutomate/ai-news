# Astro skeleton (issue #6)
node_modules/
dist/
.astro/

# public/ is generated by `npm run prebuild` (scripts/stage-astro-public.mjs)
# from the canonical root assets. It is build output, not source — do not commit.
public/

# Environment / secrets — NEVER commit.
# The Starwind Pro license (STARWIND_LICENSE_KEY) lives only in the local/agent
# environment or .env.local and must never be committed, echoed, or logged.
.env
.env.*
.env.local
.env.*.local
# Allow the committed template (no secret value in it).
!.env.example
npm-debug.log*
.DS_Store
